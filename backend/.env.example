# Copy to .env for local overrides. Defaults already match docker-compose.yml.

# --- Database (Postgres + pgvector) ---
DATABASE_URL=postgresql+psycopg://govintel:govintel@localhost:5432/govintel
TEST_DATABASE_URL=postgresql+psycopg://govintel:govintel@localhost:5432/govintel_test
SQL_ECHO=false

# --- API / security ---
# JSON map of API key -> "<organization_id>:<role>". With none set, the API
# rejects every request (fail closed). Use long random keys in production.
API_KEYS={"change-me-dev-key":"00000000-0000-0000-0000-000000000000:admin"}
# JSON array of allowed browser origins for the dashboard (CORS). Empty = none.
CORS_ORIGINS=[]
RATE_LIMIT_PER_MINUTE=120
# Serve live data from Postgres (SqlAlchemyLeadRepository) instead of the in-memory demo.
USE_DB_REPOSITORY=false

# --- Secrets (never logged; keep out of source control) ---
# Crawl LLM extraction: OpenAI preferred, Anthropic fallback, else regex rules.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Contact/enrichment providers (when wired):
# DATA_GOV_IN_API_KEY=
# APOLLO_API_KEY=
# HUNTER_API_KEY=

# --- Retention / privacy (India DPDP) ---
CONTACT_RETENTION_DAYS=365
RAW_DOCUMENT_RETENTION_DAYS=730
