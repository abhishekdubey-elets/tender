# Copy to .env for local overrides. Defaults already match docker-compose.yml.

# Primary application database (Postgres + pgvector).
DATABASE_URL=postgresql+psycopg://govintel:govintel@localhost:5432/govintel

# Dedicated test database (safe to drop/recreate).
TEST_DATABASE_URL=postgresql+psycopg://govintel:govintel@localhost:5432/govintel_test

# Echo SQL to stdout (debug).
SQL_ECHO=false
